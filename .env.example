# Optional. When set, company enrichment appends a few sourced web snippets.
# The board works without this.
# TAVILY_API_KEY=

# Optional. Ask about one open job, or write the role comparison.
# The skill gaps on each role card work without this, and the feed is never scored.
# For OpenAI, set the key and leave the base URL commented out.
# For a free local server such as Ollama, set the base URL and any non-empty key:
# OPENAI_API_KEY=
# OPENAI_BASE_URL=http://127.0.0.1:11434/v1
# OPENAI_MODEL=llama3.2

# Optional India job search. Register a free key at https://developer.adzuna.com/
# ADZUNA_APP_ID=
# ADZUNA_APP_KEY=

# Optional hosted database. Set both. The board then uses Turso instead of data/jobs.sqlite.
# JOB_BOARD_DB forces the local file, which is how the tests stay off Turso.
# TURSO_DATABASE_URL=
# TURSO_AUTH_TOKEN=
